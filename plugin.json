{
  "id": "remote_library_server",
  "name": "Remote Library Server",
  "version": "0.2.1",
  "private": false,
  "nav": { "label": "Remote Server", "screen": "remote-library-server" },
  "screen": "screen.html",
  "settings": { "html": "settings.html" },
  "script": "screen.js",
  "routes": "routes.py",
  "standards": ["plugin-runtime-idempotent.v1"],
  "capabilities": {
